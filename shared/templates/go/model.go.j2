{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies %}{% if dependency.target.id == link.id %}{{ dependency.symbol }}{% endif %}{% endfor -%}
{%- endmacro -%}
{%- macro go_type(value) -%}
{%- if value is none -%}any
{%- elif value.is.schema -%}{{ symbol_for(value.schema) or 'any' }}
{%- elif value.is.enum -%}{{ symbol_for(value.property.enum) or 'any' }}
{%- elif value.is.boolean -%}bool
{%- elif value.is.integer -%}int64
{%- elif value.is.number -%}float64
{%- elif value.is.string or value.is.temporal -%}string
{%- elif value.is.record -%}map[string]any
{%- else -%}any
{%- endif -%}
{%- endmacro -%}
{%- macro field_type(field) -%}
{%- if field.optional or field.nullable %}*{% endif -%}
{%- if field.array is not none %}[]{% endif -%}
{{- go_type(field.value) -}}
{%- endmacro -%}
// Code generated by Dryv. DO NOT EDIT.

package {{ pack.inputs.package_name }}

// {{ file.symbol }} represents {{ schema.description or schema.name.title }}.
type {{ file.symbol }} struct {
{%- for field in schema.fields %}
	{{ field.name.pascal }} {{ field_type(field) }} `json:"{{ field.name.raw }}{% if field.optional %},omitempty{% endif %}"`
{%- endfor %}
}
