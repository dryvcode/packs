{#- The generated symbol of another planned file, found by the subject it represents. -#}
{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == link.id -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro dart_type(value) -%}
{%- if value.kind == 'schema' -%}{{ symbol_for(value.schema) or 'Object?' }}
{%- elif value.kind == 'property' and value.property.kind == 'enum' -%}{{ symbol_for(value.property.enum) }}
{%- elif value.kind == 'property' and value.property.kind == 'primitive' and value.property.primitive.type == 'boolean' -%}bool
{%- elif value.kind == 'property' and value.property.kind == 'primitive' and value.property.primitive.type == 'number' and value.property.primitive.kind == 'integer' -%}int
{%- elif value.kind == 'property' and value.property.kind == 'primitive' and value.property.primitive.type == 'number' -%}double
{%- elif value.kind == 'property' and value.property.kind == 'primitive' -%}String
{%- elif value.kind == 'property' and value.property.kind == 'temporal' and value.property.temporal.kind in ['instant', 'date', 'date-time', 'datetime'] -%}DateTime
{%- elif value.kind == 'property' and value.property.kind == 'temporal' -%}String
{%- elif value.kind == 'property' and value.property.kind == 'record' -%}Map<String, dynamic>
{%- else -%}Object?
{%- endif -%}
{%- endmacro -%}
{%- macro response_type(operation) -%}
{%- if operation.output -%}{{ dart_type(operation.output.value) }}{%- else -%}void{%- endif -%}
{%- endmacro -%}

{#- "yes" when the operation's first output is a generated model. -#}
{%- macro returns_model(operation) -%}
{%- if operation.output and operation.output.value.kind == 'schema' and symbol_for(operation.output.value.schema) -%}yes{%- endif -%}
{%- endmacro -%}

{%- macro request_class(method) -%}
{%- if method == 'GET' -%}GetRequest{%- elif method == 'POST' -%}PostRequest{%- elif method == 'PUT' -%}PutRequest{%- elif method == 'PATCH' -%}PatchRequest{%- else -%}DeleteRequest{%- endif -%}
{%- endmacro -%}

{%- macro to_json(binding) -%}
{%- if binding.port.value.kind == 'schema' and symbol_for(binding.port.value.schema) -%}{{ binding.port.name.camel }}.toJson(){%- else -%}{{ binding.port.name.camel }}{%- endif -%}
{%- endmacro -%}

{%- macro has(http, kind) -%}
{%- for binding in http.inputs -%}{%- if binding.kind == kind -%}yes{%- endif -%}{%- endfor -%}
{%- endmacro -%}
import 'package:flutter_api_bridge/flutter_api_bridge.dart';
{%- for dependency in file.dependencies %}{% if dependency.symbol and dependency.symbol != file.symbol %}
import '{{ dependency.path.relative }}';
{%- endif %}{% endfor %}

/// Typed client for the {{ group.name.title }} group. Every method runs through the package's
/// ApiConnection and tags its request with a stable operation ID.
class {{ file.symbol }} {
  const {{ file.symbol }}(this._connection);

  final ApiConnection _connection;

  static const _routes = {{ group.name.pascal }}Endpoints();
{%- for operation in operations %}
{%- set http = operation.facets.http %}
{%- set options_type = 'ApiGetRequestOptions' if http.method == 'GET' else 'ApiRequestOptions' %}

  /// {{ operation.description or operation.name.title }}
  ///
  /// {{ http.method }} {{ http.path.local }}
  Future<ApiResult<{{ response_type(operation) }}>> {{ operation.name.camel }}({
{%- for binding in http.inputs %}
{%- if binding.kind == 'path' %}
    required String {{ binding.port.name.camel }},
{%- elif binding.kind == 'body' %}
    required {{ dart_type(binding.port.value) }} {{ binding.port.name.camel }},
{%- elif binding.kind == 'query' or binding.kind == 'query-object' %}
    {{ dart_type(binding.port.value) }}{% if dart_type(binding.port.value) != 'Object?' %}?{% endif %} {{ binding.port.name.camel }},
{%- endif %}
{%- endfor %}
    {{ options_type }}? options,
  }) {
    return _connection.execute(
      {{ request_class(http.method) }}<{{ response_type(operation) }}>(
        endpoint: {% if has(http, 'path') %}_routes.{{ operation.name.camel }}({% for binding in http.inputs %}{% if binding.kind == 'path' %}{{ binding.name }}: {{ binding.port.name.camel }}, {% endif %}{% endfor %}){% else %}_routes.{{ operation.name.camel }}{% endif %},
        options: (options ?? const {{ options_type }}()).copyWith(operationId: '{{ group.name.snake }}.{{ operation.name.camel }}'),
{%- if has(http, 'query-object') %}
{%- for binding in http.inputs %}{% if binding.kind == 'query-object' %}
        query: {{ binding.port.name.camel }}{% if binding.port.value.kind == 'schema' %}?.toJson(){% endif %},
{%- endif %}{% endfor %}
{%- elif has(http, 'query') %}
        query: <String, Object?>{
{%- for binding in http.inputs %}{% if binding.kind == 'query' %}
          if ({{ binding.port.name.camel }} != null) '{{ binding.name }}': {{ binding.port.name.camel }},
{%- endif %}{% endfor %}
        },
{%- endif %}
{%- if http.method != 'GET' and has(http, 'body') %}
{%- for binding in http.inputs %}{% if binding.kind == 'body' %}
        body: {{ to_json(binding) }},
{%- endif %}{% endfor %}
{%- endif %}
{%- if returns_model(operation) %}
        fromJson: (json) => {{ response_type(operation) }}.fromJson(Map<String, dynamic>.from((json as Map?) ?? const {})),
{%- endif %}
      ),
    );
  }
{%- endfor %}
}
