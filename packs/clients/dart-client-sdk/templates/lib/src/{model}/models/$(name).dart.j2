{%- macro dart_type(value) -%}
{%- if value.is.schema -%}{{ value.schema.name.pascal }}
{%- elif value.is.property and value.is.enum -%}{{ value.property.enum.name.pascal }}
{%- elif value.is.property and value.is.primitive and value.property.primitive.is.boolean -%}bool
{%- elif value.is.property and value.is.primitive and value.property.primitive.is.number and value.property.primitive.is.integer -%}int
{%- elif value.is.property and value.is.primitive and value.property.primitive.is.number -%}double
{%- elif value.is.property and value.is.primitive -%}String
{%- elif value.is.property and value.is.temporal -%}DateTime
{%- else -%}Object
{%- endif -%}
{%- endmacro -%}
{%- macro raw(key, item) -%}{% if item %}item{% else %}json['{{ key }}']{% endif %}{%- endmacro -%}
{%- macro decode(value, key, item) -%}
{%- if value.is.schema -%}{{ value.schema.name.pascal }}.fromJson({{ raw(key, item) }} as Map<String, Object?>)
{%- elif value.is.property and value.is.enum -%}{{ value.property.enum.name.pascal }}.fromJson({{ raw(key, item) }} as String)
{%- elif value.is.property and value.is.primitive and value.property.primitive.is.boolean -%}{{ raw(key, item) }} as bool
{%- elif value.is.property and value.is.primitive and value.property.primitive.is.number and value.property.primitive.is.integer -%}({{ raw(key, item) }} as num).toInt()
{%- elif value.is.property and value.is.primitive and value.property.primitive.is.number -%}({{ raw(key, item) }} as num).toDouble()
{%- elif value.is.property and value.is.primitive -%}{{ raw(key, item) }} as String
{%- elif value.is.property and value.is.temporal -%}DateTime.parse({{ raw(key, item) }} as String)
{%- else -%}{{ raw(key, item) }} as Object
{%- endif -%}
{%- endmacro -%}
{%- macro encode(value, name, nullable) -%}
{%- if value.is.schema or (value.is.property and value.is.enum) -%}{{ name }}{% if nullable %}?{% endif %}.toJson()
{%- elif value.is.property and value.is.temporal -%}{{ name }}{% if nullable %}?{% endif %}.toIso8601String()
{%- else -%}{{ name }}
{%- endif -%}
{%- endmacro -%}
{#- Non-empty when a field's type is the dependency's subject (relations only reference ids). -#}
{%- macro used(dependency) -%}
{%- for field in schema.fields -%}
{%- if field.value.is.schema and field.value.schema.id == dependency.target.id -%}x{%- endif -%}
{%- if field.value.is.property and field.value.is.enum and field.value.property.enum.id == dependency.target.id -%}x{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- for dependency in file.dependencies %}{% if dependency.symbol and dependency.symbol != file.symbol and used(dependency) %}
import '{{ dependency.path.relative }}';
{%- endif %}{% endfor %}

/// {{ schema.description or schema.name.title }}
{%- if schema.role %}
///
/// Role: {{ schema.role }}.
{%- endif %}
class {{ file.symbol }} {
  const {{ file.symbol }}({
{%- for field in schema.fields %}
    {% if not field.optional %}required {% endif %}this.{{ field.name.camel }},
{%- endfor %}
  });

  factory {{ file.symbol }}.fromJson(Map<String, Object?> json) => {{ file.symbol }}(
{%- for field in schema.fields %}
{%- if field.array is not none %}
        {{ field.name.camel }}: {% if field.optional or field.nullable %}json['{{ field.name.raw }}'] == null ? null : {% endif %}[for (final item in json['{{ field.name.raw }}'] as List<Object?>) {{ decode(field.value, field.name.raw, true) }}],
{%- elif field.optional or field.nullable %}
        {{ field.name.camel }}: json['{{ field.name.raw }}'] == null ? null : {{ decode(field.value, field.name.raw, false) }},
{%- else %}
        {{ field.name.camel }}: {{ decode(field.value, field.name.raw, false) }},
{%- endif %}
{%- endfor %}
      );
{% for field in schema.fields %}
  final {% if field.array is not none %}List<{% endif %}{{ dart_type(field.value) }}{% if field.array is not none %}>{% endif %}{% if field.optional or field.nullable %}?{% endif %} {{ field.name.camel }};
{%- endfor %}

  Map<String, Object?> toJson() => {
{%- for field in schema.fields %}
{%- if field.array is not none %}
        '{{ field.name.raw }}': {{ field.name.camel }}{% if field.optional or field.nullable %}?{% endif %}.map((item) => {{ encode(field.value, 'item', false) }}).toList(),
{%- elif field.optional or field.nullable %}
        '{{ field.name.raw }}': {{ encode(field.value, field.name.camel, true) }},
{%- else %}
        '{{ field.name.raw }}': {{ encode(field.value, field.name.camel, false) }},
{%- endif %}
{%- endfor %}
      };
}

