{#- The generated symbol of another planned file, found by the subject it represents. -#}
{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == link.id -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro ts_type(value) -%}
{%- if value.kind == 'schema' -%}{{ symbol_for(value.schema) or 'unknown' }}
{%- elif value.kind == 'property' and value.property.kind == 'enum' -%}{{ symbol_for(value.property.enum) }}
{%- elif value.kind == 'property' and value.property.kind == 'primitive' -%}{{ value.property.primitive.type }}
{%- elif value.kind == 'property' and value.property.kind == 'temporal' -%}string
{%- elif value.kind == 'property' and value.property.kind == 'record' -%}Record<string, unknown>
{%- else -%}unknown
{%- endif -%}
{%- endmacro -%}
{%- for dependency in file.dependencies %}{% if dependency.symbol and dependency.symbol != file.symbol %}
import {% if dependency.template != 'enum' %}type {% endif %}{ {{ dependency.symbol }} } from './{{ dependency.path.relative | replace(".ts", "") }}';
{%- endif %}{% endfor %}

/** {{ schema.description or schema.name.title }} */
export interface {{ file.symbol }} {
{%- for field in schema.fields %}
  {{ field.name.camel }}{% if field.optional %}?{% endif %}: {{ ts_type(field.value) }}{% if field.array is not none %}[]{% endif %}{% if field.nullable %} | null{% endif %};
{%- endfor %}
}
