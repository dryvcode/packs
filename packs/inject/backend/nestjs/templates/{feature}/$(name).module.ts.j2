{%- macro has_slot(slot) -%}
{%- for dependency in file.dependencies -%}{%- if dependency.slot == slot -%}x{%- endif -%}{%- endfor -%}
{%- endmacro -%}
{#- A project may bind its own implementation; otherwise the one in the service file is used. -#}
{%- macro bound_implementation() -%}
{%- for dependency in file.dependencies %}{% if dependency.slot == 'operation.implementation' %}{% for operation in operations %}{% if dependency.target.id == operation.id %}{{ dependency.symbol }}{% endif %}{% endfor %}{% endif %}{% endfor -%}
{%- endmacro -%}
{%- set persistence = has_slot('schema.persistence') != '' -%}
import { Module, type Type } from "@nestjs/common";
{%- if persistence %}
import { TypeOrmModule } from "@nestjs/typeorm";
{%- endif %}
{#- An implementation or use case belongs here only when it serves one of this feature's own
    operations; a referenced operation of another feature brings its own artifacts along. -#}
{%- macro own(dependency) -%}
{%- for operation in operations -%}{%- if dependency.target.id == operation.id -%}x{%- endif -%}{%- endfor -%}
{%- endmacro -%}
{%- for dependency in file.dependencies %}{% if dependency.symbol and (dependency.slot == 'schema.persistence' or (dependency.slot in ['operation.implementation', 'operation.usecase', 'module.provider'] and own(dependency) != '')) %}
import { {{ dependency.symbol }} } from "{{ (dependency.path.prefixed or ('./' ~ dependency.path.relative)) }}";
{%- endif %}{% endfor %}

import { {{ group.name.pascal }}{{ feature.name.pascal }}Controller } from "./{{ feature.name.kebab }}.controller.ts";
import { {{ group.name.pascal }}{{ feature.name.pascal }}Service, {{ group.name.pascal }}{{ feature.name.pascal }}ServiceImpl } from "./{{ feature.name.kebab }}.service.ts";

@Module({
{%- if persistence %}
  imports: [
    TypeOrmModule.forFeature([
{%- for entity in file.dependencies %}{% if entity.slot == 'schema.persistence' %}
      {{ entity.symbol }},
{%- endif %}{% endfor %}
    ]),
  ],
{%- endif %}
  controllers: [{{ group.name.pascal }}{{ feature.name.pascal }}Controller],
  providers: [
    {
      provide: {{ group.name.pascal }}{{ feature.name.pascal }}Service,
      useClass: {{ bound_implementation() or (group.name.pascal ~ feature.name.pascal ~ 'ServiceImpl') }} satisfies Type<{{ group.name.pascal }}{{ feature.name.pascal }}Service>,
    },
{%- for usecase in file.dependencies %}{% if usecase.slot == 'operation.usecase' and own(usecase) != '' %}
    {{ usecase.symbol }},
{%- endif %}{% endfor %}
{%- for provider in file.dependencies %}{% if provider.slot == 'module.provider' and own(provider) != '' %}
    {{ provider.symbol }},
{%- endif %}{% endfor %}
  ],
  exports: [{{ group.name.pascal }}{{ feature.name.pascal }}Service],
})
export class {{ file.symbol }} {}
