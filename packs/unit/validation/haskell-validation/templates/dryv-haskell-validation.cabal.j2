cabal-version:      3.0
name:               dryv-haskell-validation
version:            0.1.0
build-type:         Simple

library
  hs-source-dirs:      src
  exposed-modules:
      Dryv.Models
  build-depends:
      base >=4.18 && <5,
      aeson >=2.2 && <2.4,
      regex-tdfa,
      scientific,
      text
  default-language:    GHC2021
