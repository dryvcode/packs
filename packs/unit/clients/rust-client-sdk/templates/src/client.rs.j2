use std::fmt::Display;

use reqwest::{
    header::{HeaderMap, HeaderName, HeaderValue, COOKIE},
    Method, RequestBuilder, StatusCode,
};
use serde::{Serialize, de::DeserializeOwned};
use serde_json::Value;

#[derive(Debug)]
pub struct ApiError {
    pub status: Option<StatusCode>,
    pub message: String,
    pub payload: Option<Value>,
}

impl ApiError {
    pub fn unsupported(message: impl Into<String>) -> Self {
        Self {
            status: None,
            message: message.into(),
            payload: None,
        }
    }
}

impl std::fmt::Display for ApiError {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self.status {
            Some(status) => write!(formatter, "api request failed with status {}: {}", status.as_u16(), self.message),
            None => formatter.write_str(&self.message),
        }
    }
}

impl std::error::Error for ApiError {}

#[derive(Clone)]
pub struct Client {
    base_url: String,
    http: reqwest::Client,
    headers: HeaderMap,
}

impl Client {
    pub fn new(base_url: impl Into<String>) -> Self {
        Self {
            base_url: base_url.into().trim_end_matches('/').to_owned(),
            http: reqwest::Client::new(),
            headers: HeaderMap::new(),
        }
    }

    pub fn with_http_client(mut self, http: reqwest::Client) -> Self {
        self.http = http;
        self
    }

    pub fn insert_header(
        &mut self,
        name: HeaderName,
        value: HeaderValue,
    ) -> Option<HeaderValue> {
        self.headers.insert(name, value)
    }

    pub(crate) fn request(&self, method: Method, path: &str) -> RequestBuilder {
        self.http
            .request(method, format!("{}{}", self.base_url, path))
            .headers(self.headers.clone())
    }

    pub(crate) async fn execute<T>(&self, request: RequestBuilder) -> Result<T, ApiError>
    where
        T: DeserializeOwned,
    {
        let response = request.send().await.map_err(transport_error)?;
        let status = response.status();
        let bytes = response.bytes().await.map_err(transport_error)?;
        if !status.is_success() {
            return Err(response_error(status, &bytes));
        }
        serde_json::from_slice(&bytes).map_err(|error| ApiError {
            status: Some(status),
            message: format!("invalid JSON response: {error}"),
            payload: None,
        })
    }

    pub(crate) async fn execute_empty(&self, request: RequestBuilder) -> Result<(), ApiError> {
        let response = request.send().await.map_err(transport_error)?;
        let status = response.status();
        let bytes = response.bytes().await.map_err(transport_error)?;
        if !status.is_success() {
            return Err(response_error(status, &bytes));
        }
        Ok(())
    }
}

pub(crate) fn replace_path(path: &str, name: &str, value: impl Display) -> String {
    let encoded: String = url::form_urlencoded::byte_serialize(value.to_string().as_bytes()).collect();
    path.replace(&format!("{{{name}}}"), &encoded)
}

pub(crate) fn append_query<T>(path: &str, value: &T) -> Result<String, ApiError>
where
    T: Serialize,
{
    let query = serde_urlencoded::to_string(value).map_err(|error| ApiError {
        status: None,
        message: format!("cannot encode query: {error}"),
        payload: None,
    })?;
    if query.is_empty() {
        return Ok(path.to_owned());
    }
    let separator = if path.contains('?') { '&' } else { '?' };
    Ok(format!("{path}{separator}{query}"))
}

pub(crate) fn add_header(
    request: RequestBuilder,
    name: &str,
    value: impl Display,
) -> Result<RequestBuilder, ApiError> {
    let name = HeaderName::from_bytes(name.as_bytes()).map_err(|error| ApiError {
        status: None,
        message: format!("invalid header name {name}: {error}"),
        payload: None,
    })?;
    let value = HeaderValue::from_str(&value.to_string()).map_err(|error| ApiError {
        status: None,
        message: format!("invalid header value: {error}"),
        payload: None,
    })?;
    Ok(request.header(name, value))
}

pub(crate) fn add_cookie(
    request: RequestBuilder,
    name: &str,
    value: impl Display,
) -> Result<RequestBuilder, ApiError> {
    let cookie = format!("{name}={}", value);
    Ok(request.header(COOKIE, cookie))
}

fn transport_error(error: reqwest::Error) -> ApiError {
    ApiError {
        status: error.status(),
        message: error.to_string(),
        payload: None,
    }
}

fn response_error(status: StatusCode, bytes: &[u8]) -> ApiError {
    let payload = serde_json::from_slice::<Value>(bytes).ok();
    let message = payload
        .as_ref()
        .and_then(|value| value.get("message"))
        .and_then(Value::as_str)
        .map(str::to_owned)
        .unwrap_or_else(|| String::from_utf8_lossy(bytes).trim().to_owned());

    ApiError {
        status: Some(status),
        message,
        payload,
    }
}
