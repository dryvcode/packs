{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies %}{% if dependency.target.id == link.id %}{{ dependency.symbol }}{% endif %}{% endfor -%}
{%- endmacro -%}
{%- macro ts_type(value) -%}
{%- if value is none -%}unknown
{%- elif value.is.schema -%}{{ symbol_for(value.schema) or 'unknown' }}
{%- elif value.is.enum -%}{{ symbol_for(value.property.enum) or 'string' }}
{%- elif value.is.boolean -%}boolean
{%- elif value.is.number -%}number
{%- elif value.is.string or value.is.temporal -%}string
{%- elif value.is.record -%}Record<string, unknown>
{%- else -%}unknown
{%- endif -%}
{%- endmacro -%}
{%- for dependency in file.dependencies %}{% if dependency.symbol and not dependency.is_self %}
import {% if dependency.template != 'enum' %}type {% endif %}{ {{ dependency.symbol }} } from "./{{ dependency.path.relative }}";
{%- endif %}{% endfor %}

/** {{ schema.description or schema.name.title }} */
export interface {{ file.symbol }} {
{%- for field in schema.fields %}
  {{ field.name.raw }}{% if field.optional %}?{% endif %}: {{ ts_type(field.value) }}{% if field.array is not none %}[]{% endif %}{% if field.nullable %} | null{% endif %};
{%- endfor %}
}
