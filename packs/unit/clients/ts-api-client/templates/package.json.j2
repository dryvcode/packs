{
  "name": "{{ pack.inputs.package_name }}",
  "version": "0.1.0",
  "description": {{ (application.name.title ~ ' API client generated by Dryv.') | tojson }},
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./operations/*": "./src/operations/*.ts",
    "./models/*": "./src/models/*.ts",
    "./enums/*": "./src/enums/*.ts"
  },
  "sideEffects": false
}
