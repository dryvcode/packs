cabal-version:      3.0
name:               dryv-haskell-client
version:            0.1.0
build-type:         Simple

library
  hs-source-dirs:      src
  exposed-modules:
      Dryv.Client
      Dryv.Models
      Dryv.Operations
  build-depends:
      base >=4.18 && <5,
      aeson >=2.2 && <2.4,
      bytestring,
      case-insensitive,
      http-client >=0.7,
      http-client-tls >=0.4 && <0.5,
      http-types,
      scientific,
      text,
      regex-tdfa,
      unordered-containers,
      vector
  default-language:    GHC2021
