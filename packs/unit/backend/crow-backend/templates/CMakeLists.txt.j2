cmake_minimum_required(VERSION 3.23)
project(dryv_cpp_backend VERSION 0.1.0 LANGUAGES CXX)

find_package(Crow 1.3.4 CONFIG REQUIRED)
find_package(nlohmann_json 3.12.0 CONFIG REQUIRED)

add_library(dryv_cpp_backend INTERFACE)
target_compile_features(dryv_cpp_backend INTERFACE cxx_std_20)
target_include_directories(dryv_cpp_backend INTERFACE ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_link_libraries(dryv_cpp_backend INTERFACE Crow::Crow nlohmann_json::nlohmann_json)
