{%- macro java_ident(name) -%}
{%- if name in ['abstract','assert','boolean','break','byte','case','catch','char','class','const','continue','default','do','double','else','enum','extends','final','finally','float','for','goto','if','implements','import','instanceof','int','interface','long','native','new','package','private','protected','public','return','short','static','strictfp','super','switch','synchronized','this','throw','throws','transient','try','void','volatile','while','record','sealed','permits','yield','var'] -%}{{ name }}_{%- else -%}{{ name }}{%- endif -%}
{%- endmacro -%}
{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == link.id and dependency.symbol -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro base_type(value) -%}
{%- if value is none -%}Object
{%- elif value.is.schema -%}{{ symbol_for(value.schema) or 'Object' }}
{%- elif value.is.enum -%}{{ symbol_for(value.property.enum) or 'Object' }}
{%- elif value.is.boolean -%}Boolean
{%- elif value.is.integer -%}Long
{%- elif value.is.decimal or value.is.money -%}BigDecimal
{%- elif value.is.number -%}Double
{%- elif value.is.temporal and value.is.date -%}LocalDate
{%- elif value.is.temporal and value.is.time -%}LocalTime
{%- elif value.is.temporal and value.is.date_time -%}LocalDateTime
{%- elif value.is.temporal and value.is.instant -%}Instant
{%- elif value.is.temporal and value.is.zoned_date_time -%}OffsetDateTime
{%- elif value.is.temporal and value.is.duration -%}Duration
{%- elif value.is.temporal and value.is.year_month -%}YearMonth
{%- elif value.is.temporal and value.is.month_day -%}MonthDay
{%- elif value.is.record -%}Map<String, Object>
{%- elif value.is.string -%}String
{%- else -%}Object
{%- endif -%}
{%- endmacro -%}
{%- macro field_type(field) -%}
{%- if field.array is not none -%}List<{{ base_type(field.value) }}>{%- else -%}{{ base_type(field.value) }}{%- endif -%}
{%- endmacro -%}
package {{ pack.inputs.java_package }}.services;

{%- for dependency in file.dependencies %}{% if dependency.symbol and not dependency.is_self %}
import {{ pack.inputs.java_package }}.models.{{ dependency.symbol }};
{%- endif %}{% endfor %}

import java.math.BigDecimal;
import java.time.Duration;
import java.time.Instant;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.LocalTime;
import java.time.MonthDay;
import java.time.OffsetDateTime;
import java.time.YearMonth;
import java.util.List;
import java.util.Map;

public interface {{ file.symbol }} {
{%- for operation in operations %}
{%- if operation.input and operation.input.kind != 'schema' %}
    record {{ operation.name.pascal }}Input(
{%- for field in operation.input.fields %}
        {{ field_type(field) }} {{ java_ident(field.name.camel) }}{% if not loop.last %},{% endif %}
{%- endfor %}
    ) {}

{%- endif %}
    {% if operation.output %}{{ base_type(operation.output.value) }}{% else %}void{% endif %} {{ java_ident(operation.name.camel) }}(
{%- if operation.input %}
        {% if operation.input.kind == 'schema' %}{{ base_type(operation.input.value) }}{% else %}{{ operation.name.pascal }}Input{% endif %} input
{%- endif %}
    );
{%- endfor %}
}
