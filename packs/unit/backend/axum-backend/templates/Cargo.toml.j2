[package]
name = "{{ pack.inputs.crate_name }}"
version = "0.1.0"
edition = "2021"

[dependencies]
async-trait = "0.1"
axum = { version = "0.8", features = ["form", "json", "multipart"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"

{% if pack.inputs.repositories %}
sea-orm = { version = "=2.0.4", default-features = false, features = ["sqlx-postgres", "runtime-tokio-rustls", "with-json", "with-uuid", "with-time", "with-rust_decimal"] }
async-recursion = "1"
regex = "1"
time = { version = "0.3", features = ["formatting", "parsing"] }
uuid = { version = "1", features = ["v4"] }
tracing = "0.1"
{% endif %}
