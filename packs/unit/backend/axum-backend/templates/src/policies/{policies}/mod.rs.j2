use crate::{ApiError, persistence::{Caller, Row}};

{% for policy in policies %}
#[derive(Clone, Debug, serde::Serialize)]
pub struct {{ policy.group.name.pascal }}{{ policy.name.pascal }}Context {
{% for provided in policy.context.provides %}    #[serde(rename = "{{ provided.name.raw }}")]
    pub {% if provided.name.snake in ['self', 'super', 'crate'] %}{{ provided.name.snake }}_{% else %}r#{{ provided.name.snake }}{% endif %}: {{ rust_type(provided.resolved) }},
{% endfor %}}
{% endfor %}
#[async_trait::async_trait]
pub trait PolicyEvaluator: Send + Sync + 'static {
{% for policy in policies %}    async fn {{ policy.group.name.snake }}_{{ policy.name.snake }}(&self, caller: Option<&Caller>) -> Result<{{ policy.group.name.pascal }}{{ policy.name.pascal }}Context, ApiError>;
{% endfor %}}

pub(crate) async fn evaluate<P: PolicyEvaluator>(evaluator: &P, policy: &str, caller: Option<&Caller>) -> Result<Row, ApiError> {
    match policy {
{% for policy in policies %}        "{{ policy.id }}" => {
            let values = evaluator.{{ policy.group.name.snake }}_{{ policy.name.snake }}(caller).await?;
            serde_json::from_value(serde_json::to_value(values).map_err(|_| ApiError::internal())?).map_err(|_| ApiError::internal())
        },
{% endfor %}        _ => { let _ = (evaluator, caller); Err(ApiError::denied()) },
    }
}
{% endif %}
