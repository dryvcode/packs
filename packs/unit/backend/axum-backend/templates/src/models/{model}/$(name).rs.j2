{%- macro rust_ident(name) -%}
{%- if name in ['self', 'super', 'crate'] -%}{{ name }}_
{%- elif name in ['as', 'break', 'const', 'continue', 'else', 'enum', 'extern', 'false', 'fn', 'for', 'if', 'impl', 'in', 'let', 'loop', 'match', 'mod', 'move', 'mut', 'pub', 'ref', 'return', 'static', 'struct', 'trait', 'true', 'type', 'unsafe', 'use', 'where', 'while', 'async', 'await', 'dyn', 'abstract', 'become', 'box', 'do', 'final', 'macro', 'override', 'priv', 'typeof', 'unsized', 'virtual', 'yield', 'try', 'gen'] -%}r#{{ name }}
{%- else -%}{{ name }}
{%- endif -%}
{%- endmacro -%}
{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == link.id -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro base_type(value) -%}
{%- if value is none -%}serde_json::Value
{%- elif value.is.schema -%}{{ symbol_for(value.schema) or 'serde_json::Value' }}
{%- elif value.is.enum -%}{{ symbol_for(value.property.enum) or 'serde_json::Value' }}
{%- elif value.is.boolean -%}bool
{%- elif value.is.integer -%}i64
{%- elif value.is.number -%}f64
{%- elif value.is.record -%}HashMap<String, serde_json::Value>
{%- elif value.is.string or value.is.temporal -%}String
{%- else -%}serde_json::Value
{%- endif -%}
{%- endmacro -%}

{%- macro field_type(field) -%}
{%- if field.array is not none -%}{% set inner = 'Vec<' ~ base_type(field.value) ~ '>' %}
{%- else -%}{% set inner = base_type(field.value) %}
{%- endif -%}
{%- if field.optional or field.nullable -%}Option<{{ inner }}>{%- else -%}{{ inner }}{%- endif -%}
{%- endmacro -%}
use std::collections::HashMap;

use serde::{Deserialize, Serialize};
{%- for dependency in file.dependencies %}{% if dependency.symbol and not dependency.is_self %}
use crate::models::{{ dependency.symbol }};
{%- endif %}{% endfor %}

#[derive(Clone, Debug, Serialize, Deserialize)]
pub struct {{ file.symbol }} {
{%- for field in schema.fields %}
    #[serde(rename = "{{ field.name.raw }}"{% if field.optional %}, default, skip_serializing_if = "Option::is_none"{% endif %})]
    pub {{ rust_ident(field.name.snake) }}: {{ field_type(field) }},
{%- endfor %}
}
