        }
{{ parse_values(field, 'values' ~ field.name.pascal, target) }}
{%- endif %}
{%- elif binding.is.body %}
        var parsed{{ field.name.pascal }} = await context.Request.ReadFromJsonAsync<{{ field_type(field) }}>(cancellationToken: cancellationToken);
{%- if not field.optional %}
        if (parsed{{ field.name.pascal }} is null)
