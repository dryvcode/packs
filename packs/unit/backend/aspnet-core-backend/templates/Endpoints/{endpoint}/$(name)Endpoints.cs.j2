        {
            return Results.BadRequest(new { message = "Invalid {{ field.name.raw }}" });
        }
        {{ target }} = parsed{{ field.name.pascal }};
{%- endif -%}
{%- endmacro -%}
{%- macro assign_direct(field, binding, target) -%}
{%- if binding.is.path %}
        var values{{ field.name.pascal }} = new StringValues(context.Request.RouteValues.TryGetValue("{{ binding.name or binding.port.name.raw }}", out var route{{ field.name.pascal }}) ? route{{ field.name.pascal }}?.ToString() : null);
