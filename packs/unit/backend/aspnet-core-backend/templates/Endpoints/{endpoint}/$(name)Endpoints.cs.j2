{%- elif binding.is.cookie %}
        var values{{ field.name.pascal }} = new StringValues(context.Request.Cookies.TryGetValue("{{ binding.name or binding.port.name.raw }}", out var cookie{{ field.name.pascal }}) ? cookie{{ field.name.pascal }} : null);
{%- elif binding.is.form %}
        var values{{ field.name.pascal }} = form["{{ binding.name or binding.port.name.raw }}"];
{%- endif %}
{%- if binding.is.path or binding.is.query or binding.is.header or binding.is.cookie or binding.is.form %}
{%- if field.optional %}
        if (values{{ field.name.pascal }}.Count > 0)
        {
{{ parse_values(field, 'values' ~ field.name.pascal, target) }}
        }
{%- else %}
