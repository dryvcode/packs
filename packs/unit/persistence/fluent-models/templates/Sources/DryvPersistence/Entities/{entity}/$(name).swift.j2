{%- if field.mutation == 'system' and not (field.value.is.integer or field.value.is.uuid) -%}{%- set pk.system_unsupported = true -%}{%- endif -%}
{%- if field.mutation == 'system' -%}{%- set pk.has_system_composite = true -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}

