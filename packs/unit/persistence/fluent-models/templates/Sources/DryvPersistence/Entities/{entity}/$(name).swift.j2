{%- elif value.is.decimal or value.is.money -%}String
{%- elif value.is.number -%}Double
{%- elif value.is.uuid -%}UUID
{%- elif value.is.temporal and (value.is.date or value.is.time or value.is.date_time or value.is.instant or value.is.zoned_date_time) -%}Date
{%- elif value.is.string or value.is.temporal -%}String
{%- else -%}DryvJSONValue
{%- endif -%}
{%- endmacro -%}

{%- macro data_type(field) -%}
{%- set value = field.value -%}
{%- if field.array is not none -%}.array(of: {{ scalar_data_type(value) }})
{%- else -%}{{ scalar_data_type(value) }}
{%- endif -%}
{%- endmacro -%}

{%- macro scalar_data_type(value) -%}
