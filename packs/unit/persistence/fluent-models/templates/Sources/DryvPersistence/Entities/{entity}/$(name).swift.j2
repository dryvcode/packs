public struct {{ file.symbols.migration }}: AsyncMigration {
    public init() {}

    public func prepare(on database: any Database) async throws {
        let schema = database.schema(
            {{ file.symbols.entity }}.schema,
            space: {{ file.symbols.entity }}.space
        )

{%- for field in schema.fields %}
{%- if field.related is none %}
        schema.field(
            "{{ field.name.snake }}",
            {{ data_type(field) }}{% if field.storage is not none and field.storage.primary_key and pk.count == 1 %},
            .identifier(auto: {% if field.mutation == 'system' and field.value.is.integer %}true{% else %}false{% endif %}){% endif %}{% if not field.optional and not field.nullable %},
            .required{% endif %}
        )
{%- endif %}
{%- endfor %}

{%- if pk.count > 1 %}
        schema.compositeIdentifier(
{%- set comp = namespace(first=true) %}
{%- for field in schema.fields %}{% if field.storage is not none and field.storage.primary_key %}
            {% if not comp.first %},{% endif %}"{{ field.name.snake }}"{% set comp.first = false %}
{%- endif %}{% endfor %}
        )
{%- endif %}

{%- if schema.facets.storage is not none %}
{%- for index in schema.facets.storage.indexes %}
{%- if index.unique %}
        schema.unique(
            on: {% for indexed in index.fields %}"{{ indexed.snake }}"{% if not loop.last %}, {% endif %}{% endfor %}{% if index.name %},
            name: "{{ index.name }}"{% endif %}
        )
{%- else %}
        // Fluent has no portable non-unique index builder for "{{ index.name or ('idx_' ~ schema.name.snake ~ '_' ~ loop.index) }}".
{%- endif %}
{%- endfor %}
{%- endif %}

{%- for field in schema.fields %}
{%- if field.relation is not none and symbol_for(field.relation.target.schema) %}
        schema.foreignKey(
            "{{ field.name.snake }}",
            references: {{ symbol_for(field.relation.target.schema) }}.schema,
            inSpace: {{ symbol_for(field.relation.target.schema) }}.space,
            "{{ field.relation.target.field.snake }}",
            onDelete: {{ fk_action(field.relation.on_delete) }},
            onUpdate: {{ fk_action(field.relation.on_update) }}
        )
{%- if field.relation.is.one_to_one %}
        schema.unique(on: "{{ field.name.snake }}")
{%- endif %}
{%- endif %}
{%- endfor %}

        try await schema.create()
    }

    public func revert(on database: any Database) async throws {
