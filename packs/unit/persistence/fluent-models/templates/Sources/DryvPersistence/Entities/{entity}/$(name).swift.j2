{%- macro id_generator(field) -%}
{%- if field.mutation == 'system' and field.value.is.integer -%}.database
{%- elif field.mutation == 'system' and field.value.is.uuid -%}.random
{%- else -%}.user
{%- endif -%}
{%- endmacro -%}

{%- macro pk_supported(field) -%}
