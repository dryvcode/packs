package {{ pack.inputs.root_package }}

import io.circe.Json
import io.circe.parser
import slick.jdbc.JdbcProfile

trait DryvProfile:
  val profile: JdbcProfile
  import profile.api.*

  given BaseColumnType[Json] =
    MappedColumnType.base[Json, String](
      _.noSpaces,
      raw =>
        parser.parse(raw).fold(
          error => throw new IllegalArgumentException("Invalid JSON database value: " + error),
          identity,
        ),
    )
