Gem::Specification.new do |spec|
  spec.name = "dryv-active-record-models"
  spec.version = "0.1.0"
  spec.summary = "Active Record models generated by Dryv"
  spec.required_ruby_version = ">= 3.2"
  spec.files = Dir["lib/**/*.rb"]
  spec.require_paths = ["lib"]
  spec.add_dependency "activerecord", "8.1.4"
end
