cmake_minimum_required(VERSION 3.23)
project(dryv_cpp_persistence VERSION 0.1.0 LANGUAGES CXX)

find_package(SqliteOrm 1.9.1 CONFIG REQUIRED)

add_library(dryv_cpp_persistence INTERFACE)
target_compile_features(dryv_cpp_persistence INTERFACE cxx_std_20)
target_include_directories(dryv_cpp_persistence INTERFACE ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_link_libraries(dryv_cpp_persistence INTERFACE sqlite_orm::sqlite_orm)
