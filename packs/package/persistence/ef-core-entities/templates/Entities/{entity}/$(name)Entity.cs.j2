{%- macro cs_ident(name) -%}
{%- if name in ['abstract','as','base','bool','break','byte','case','catch','char','checked','class','const','continue','decimal','default','delegate','do','double','else','enum','event','explicit','extern','false','finally','fixed','float','for','foreach','goto','if','implicit','in','int','interface','internal','is','lock','long','namespace','new','null','object','operator','out','override','params','private','protected','public','readonly','ref','return','sbyte','sealed','short','sizeof','stackalloc','static','string','struct','switch','this','throw','true','try','typeof','uint','ulong','unchecked','unsafe','ushort','using','virtual','void','volatile','while','record','required','file','scoped'] -%}@{{ name }}{%- else -%}{{ name }}{%- endif -%}
{%- endmacro -%}
{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == link.id -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro base_type(value, array) -%}
{%- if array is not none or value is none or value.is.schema or value.is.record or value.is.unknown or value.is.dynamic or value.is.generic or value.is.composite or value.is.union or value.is.tuple or value.is.literal -%}string
{%- elif value.is.enum -%}string
{%- elif value.is.boolean -%}bool
{%- elif value.is.integer -%}long
{%- elif value.is.decimal or value.is.money -%}decimal
{%- elif value.is.number -%}double
{%- elif value.is.uuid -%}Guid
{%- elif value.is.temporal and value.is.date -%}DateOnly
{%- elif value.is.temporal and value.is.time -%}TimeOnly
{%- elif value.is.temporal and value.is.date_time -%}DateTime
{%- elif value.is.temporal and (value.is.instant or value.is.zoned_date_time) -%}DateTimeOffset
{%- elif value.is.temporal and value.is.duration -%}TimeSpan
{%- elif value.is.string -%}string
{%- else -%}string
{%- endif -%}
{%- endmacro -%}
{%- macro field_type(field) -%}
{{- base_type(field.value, field.array) -}}{%- if field.optional or field.nullable -%}?{%- endif -%}
{%- endmacro -%}
{%- macro delete_behavior(value) -%}
{%- if value == 'cascade' -%}DeleteBehavior.Cascade
{%- elif value == 'restrict' -%}DeleteBehavior.Restrict
{%- elif value == 'detach' -%}DeleteBehavior.SetNull
{%- else -%}DeleteBehavior.NoAction
{%- endif -%}
{%- endmacro -%}

