Gem::Specification.new do |spec|
  spec.name = "dryv-sequel-models"
  spec.version = "0.1.0"
  spec.summary = "Sequel persistence generated by Dryv"
  spec.files = Dir["lib/**/*.rb"]
  spec.require_paths = ["lib"]
  spec.required_ruby_version = ">= 3.3"
  spec.add_dependency "sequel", "5.109.0"
end
