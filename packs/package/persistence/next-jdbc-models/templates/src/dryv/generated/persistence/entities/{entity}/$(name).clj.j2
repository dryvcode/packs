(def ^:private sql-options
  {:builder-fn rs/as-unqualified-maps})

(defn- find-wire
  [value wire-key]
  (cond
    (contains? value wire-key)
    [true (get value wire-key)]

    (contains? value (name wire-key))
    [true (get value (name wire-key))]

    :else
    [false nil]))

(defn- encode-value
  [wire-key value]
  (if (and (contains? json-fields wire-key) (some? value))
    (json/write-value-as-string value mapper)
    value))

(defn- decode-value
  [wire-key value]
  (if (and (contains? json-fields wire-key) (string? value))
    (try
      (json/read-value value mapper)
      (catch Exception _
        value))
    value))

(defn to-row
  "Converts authored/wire map keys into database column keys without adding absent fields."
  [value]
  (reduce-kv
   (fn [row wire-key column]
     (let [[present value] (find-wire value wire-key)]
       (if present
         (assoc row column (encode-value wire-key value))
         row)))
   {}
   columns))

(defn from-row
  "Converts an unqualified next.jdbc row back to authored/wire keyword keys."
  [row]
  (reduce-kv
   (fn [value column raw]
     (if (contains? row column)
       (assoc value raw (decode-value raw (get row column)))
       value))
   {}
   reverse-columns))

(defn insert!
  [connectable value]
  (some-> (sql/insert! connectable {{ file.symbol }} (to-row value) sql-options)
          from-row))

(defn find-by
  [connectable criteria]
  (mapv from-row
        (sql/find-by-keys connectable {{ file.symbol }} (to-row criteria) sql-options)))

(defn update!
  [connectable criteria changes]
  (sql/update!
   connectable
   {{ file.symbol }}
   (select-keys (to-row changes) mutable-columns)
   (to-row criteria)
   sql-options))

(defn delete!
  [connectable criteria]
  (sql/delete! connectable {{ file.symbol }} (to-row criteria) sql-options))

(defn find-by-primary-key
  "Looks up one row using a map containing every authored primary-key field."
  [connectable key-value]
  (let [row-key (select-keys (to-row key-value) primary-key)]
    (when (= (count row-key) (count primary-key))
      (some-> (first (sql/find-by-keys
                      connectable
                      {{ file.symbol }}
                      row-key
                      (assoc sql-options :limit 1)))
              from-row))))
