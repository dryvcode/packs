(def reverse-columns
  (into {} (map (fn [[wire column]] [column wire]) columns)))

(def primary-key
  [
{%- for field in schema.fields %}
{%- if field.related is none and field.storage is not none and field.storage.primary_key %}
   :{{ field.name.snake }}
{%- endif %}
{%- endfor %}
   ])

