{%- macro persistent_type(field) -%}
{%- set value = field.value -%}
{%- if field.array is not none or value is none or value.is.schema or value.is.record or value.is.unknown or value.is.dynamic or value.is.generic or value.is.composite or value.is.union or value.is.tuple or value.is.literal or value.is.enum -%}Text
{%- elif value.is.boolean -%}Bool
{%- elif value.is.integer -%}Int64
{%- elif value.is.number -%}Double
{%- elif value.is.decimal or value.is.money -%}Text
{%- elif value.is.string or value.is.temporal or value.is.uuid -%}Text
{%- else -%}Text
{%- endif -%}
{%- endmacro -%}

{%- macro delete_action(value) -%}
{%- if value == 'cascade' -%}OnDeleteCascade
{%- elif value == 'restrict' -%}OnDeleteRestrict
{%- elif value == 'detach' -%}OnDeleteSetNull
{%- elif value == 'reset' -%}OnDeleteSetDefault
{%- endif -%}
{%- endmacro -%}

{%- macro update_action(value) -%}
{%- if value == 'cascade' -%}OnUpdateCascade
{%- elif value == 'restrict' -%}OnUpdateRestrict
{%- elif value == 'detach' -%}OnUpdateSetNull
{%- elif value == 'reset' -%}OnUpdateSetDefault
{%- endif -%}
{%- endmacro -%}

