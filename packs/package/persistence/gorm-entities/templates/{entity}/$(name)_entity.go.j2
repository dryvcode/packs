{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == link.id -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro go_type(value) -%}
{%- if value is none -%}any
{%- elif value.is.schema or value.is.record or value.is.unknown or value.is.dynamic or value.is.generic or value.is.composite or value.is.union or value.is.tuple or value.is.literal -%}map[string]any
{%- elif value.is.enum -%}string
{%- elif value.is.boolean -%}bool
{%- elif value.is.integer -%}int64
{%- elif value.is.decimal or value.is.money -%}string
{%- elif value.is.number -%}float64
{%- elif value.is.temporal and (value.is.date or value.is.time or value.is.date_time or value.is.instant or value.is.zoned_date_time) -%}time.Time
{%- elif value.is.temporal -%}string
{%- elif value.is.string -%}string
{%- else -%}any
{%- endif -%}
{%- endmacro -%}

{%- macro field_type(field) -%}
{%- if field.optional or field.nullable %}*{% endif -%}
{%- if field.array is not none %}[]{% endif -%}
{{- go_type(field.value) -}}
{%- endmacro -%}

{%- macro lifecycle(value) -%}
{%- if value == 'cascade' -%}CASCADE
{%- elif value == 'restrict' -%}RESTRICT
{%- elif value == 'detach' -%}SET NULL
{%- elif value == 'reset' -%}SET DEFAULT
{%- endif -%}
{%- endmacro -%}

{%- macro index_tags(schema, field) -%}
{%- if schema.facets.storage is not none -%}
{%- for index in schema.facets.storage.indexes -%}
{%- set generated_index_name = index.name or ('idx_' ~ schema.name.snake ~ '_' ~ loop.index) -%}
{%- for indexed in index.fields -%}
{%- if indexed.raw == field.name.raw -%}
;{% if index.unique %}uniqueIndex{% else %}index{% endif %}:{{ generated_index_name }}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- endif -%}
{%- endmacro -%}

{%- macro field_tag(schema, field) -%}
column:{{ field.name.snake }}
{%- if field.storage is not none and field.storage.primary_key %};primaryKey
{%- if not (field.value.is.integer and field.mutation == 'system') %};autoIncrement:false{%- endif -%}
{%- endif -%}
{%- if not field.optional and not field.nullable %};not null{%- endif -%}
{%- if field.mutation == 'create-only' %};<-:create{%- endif -%}
{%- if field.array is not none or field.value.is.schema or field.value.is.record or field.value.is.unknown or field.value.is.dynamic or field.value.is.generic or field.value.is.composite or field.value.is.union or field.value.is.tuple or field.value.is.literal %};serializer:json{%- endif -%}
{%- if field.value.is.decimal or field.value.is.money -%}
{%- set constraints = field.value.property.primitive.constraints -%}
{%- if constraints.has_precision and constraints.has_scale %};type:decimal({{ constraints.precision }},{{ constraints.scale }}){% else %};type:decimal{% endif -%}
{%- endif -%}
{{ index_tags(schema, field) }}
{%- if field.relation is not none and field.relation.is.one_to_one %};unique{%- endif -%}
{%- endmacro -%}

{%- set state = namespace(needs_time=false) -%}
{%- for field in schema.fields -%}
{%- if field.value.is.temporal and (field.value.is.date or field.value.is.time or field.value.is.date_time or field.value.is.instant or field.value.is.zoned_date_time) -%}
{%- set state.needs_time = true -%}
{%- endif -%}
{%- endfor -%}
// Code generated by Dryv. DO NOT EDIT.

package {{ pack.inputs.package_name }}
{%- if state.needs_time %}

import "time"
{%- endif %}

// {{ file.symbol }} maps the persistent Dryv schema {{ schema.name.title }}.
type {{ file.symbol }} struct {
{%- for field in schema.fields %}
{%- if field.related is none %}
	{{ field.name.pascal }} {{ field_type(field) }} `gorm:"{{ field_tag(schema, field) }}" json:"{{ field.name.raw }}{% if field.optional %},omitempty{% endif %}"`
{%- if field.relation is not none and symbol_for(field.relation.target.schema) %}
	{{ field.name.pascal }}Relation *{{ symbol_for(field.relation.target.schema) }} `gorm:"foreignKey:{{ field.name.pascal }};references:{{ field.relation.target.field.pascal }}{% if field.relation.on_update or field.relation.on_delete %};constraint:{% if field.relation.on_update %}OnUpdate:{{ lifecycle(field.relation.on_update) }}{% endif %}{% if field.relation.on_update and field.relation.on_delete %},{% endif %}{% if field.relation.on_delete %}OnDelete:{{ lifecycle(field.relation.on_delete) }}{% endif %}{% endif %}" json:"-"`
{%- endif %}
{%- else %}
{%- if symbol_for(field.related.via.schema) and field.related.cardinality == 'one-to-many' %}
	{{ field.name.pascal }} []{{ symbol_for(field.related.via.schema) }} `gorm:"foreignKey:{{ field.related.via.field.pascal }}" json:"-"`
{%- elif symbol_for(field.related.via.schema) and field.related.cardinality == 'one-to-one' %}
	{{ field.name.pascal }} *{{ symbol_for(field.related.via.schema) }} `gorm:"foreignKey:{{ field.related.via.field.pascal }}" json:"-"`
{%- else %}
	// {{ field.name.raw }} needs an explicit many-to-many/junction mapping.
{%- endif %}
{%- endif %}
{%- endfor %}
}

// TableName preserves the canonical Dryv storage name.
func ({{ file.symbol }}) TableName() string {
	return "{% if schema.facets.storage and schema.facets.storage.namespace %}{{ schema.facets.storage.namespace }}.{% endif %}{% if schema.facets.storage and schema.facets.storage.name %}{{ schema.facets.storage.name }}{% else %}{{ schema.name.snake }}{% endif %}"
}
