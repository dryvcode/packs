        }
{%- else %}
        header({{ (binding.name or binding.port.name.raw) | tojson }}, DryvClient.wireString({{ bound(binding) }}))
{%- endif %}
{%- endfor %}
{%- if http.input_groups.cookie %}
        val cookieParts = buildList {
{%- for binding in http.input_groups.cookie %}
