{%- for field in binding.port.value.schema.fields %}
{{ append_parameter('this', field.name.raw, 'formObject.' ~ kotlin_ident(field.name.camel), field.optional or field.nullable, field.array is not none) }}
{%- endfor %}
{%- else %}
{{ append_parameter('this', binding.name or binding.port.name.raw, bound(binding), binding_optional(operation, binding), false) }}
{%- endif %}
{%- endfor %}
    }{% else %}null{% endif %}

    val response = client.http.request {
        method = HttpMethod.parse({{ http.method | tojson }})
        url(client.baseUrl.trimEnd('/') + path)
        query.forEach { name, values ->
            values.forEach { value -> url.parameters.append(name, value) }
        }
{%- for binding in http.input_groups.header %}
{%- if binding_optional(operation, binding) %}
        {{ bound(binding) }}?.let { value ->
