    )
{%- endif %}
{%- endfor %}

    val query = Parameters.build {
{%- for binding in http.input_groups.query %}
{{ append_parameter('this', binding.name or binding.port.name.raw, bound(binding), binding_optional(operation, binding), false) }}
{%- endfor %}
{%- for binding in http.input_groups.query_object %}
{%- if binding.port.value.is.schema %}
        val queryObject = {{ bound(binding) }}
{%- for field in binding.port.value.schema.fields %}
{{ append_parameter('this', field.name.raw, 'queryObject.' ~ kotlin_ident(field.name.camel), field.optional or field.nullable, field.array is not none) }}
{%- endfor %}
{%- endif %}
{%- endfor %}
    }

    val form = {% if http.input_groups.form %}Parameters.build {
