    let {{ operation.name.camel }}Input =
          {{ hs_type(operation.input.value) }}
{%- for field in operation.input.value.schema.fields %}
            {{ field_var(operation, field) }}
{%- endfor %}
{%- else %}
{%- for field in operation.input.value.schema.fields %}
{{ parse_bound_field(operation, field) }}
{%- endfor %}
    let {{ operation.name.camel }}Input =
          {{ hs_type(operation.input.value) }}
{%- for field in operation.input.value.schema.fields %}
