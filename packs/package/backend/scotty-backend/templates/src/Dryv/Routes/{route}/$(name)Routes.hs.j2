{%- endfor %}
{%- endif %}
{%- else %}
{%- if whole_binding(http, 'body') %}
    {{ operation.name.camel }}Input <- (jsonData :: ActionM {{ operation.name.pascal }}Input)
{%- elif whole_binding(http, 'query') %}
{%- for field in operation.input.fields %}
{{ parse_schema_values(operation, field, 'queryValues', field.name.raw) }}
{%- endfor %}
    let {{ operation.name.camel }}Input =
          {{ operation.name.pascal }}Input
{%- for field in operation.input.fields %}
            {{ field_var(operation, field) }}
{%- endfor %}
{%- elif whole_binding(http, 'form') %}
{%- for field in operation.input.fields %}
{{ parse_schema_values(operation, field, 'formValues', field.name.raw) }}
{%- endfor %}
    let {{ operation.name.camel }}Input =
          {{ operation.name.pascal }}Input
{%- for field in operation.input.fields %}
            {{ field_var(operation, field) }}
{%- endfor %}
