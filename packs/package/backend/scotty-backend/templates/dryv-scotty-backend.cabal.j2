cabal-version:      3.0
name:               dryv-scotty-backend
version:            0.1.0
build-type:         Simple

library
  hs-source-dirs:      src
  exposed-modules:
      Dryv.Models
      Dryv.Routes
      Dryv.Scotty
  build-depends:
      base >=4.18 && <5,
      aeson >=2.2 && <2.4,
      bytestring,
      http-types,
      regex-tdfa,
      scientific,
      scotty >=0.30 && <0.31,
      text
  default-language:    GHC2021
