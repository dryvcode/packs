{%- macro schema_from_params(binding, source) -%}
{%- set object = binding_var(binding) -%}
	var {{ object }} {{ go_type(binding.port.value) }}
{%- if source == 'form' %}
	if err := r.ParseForm(); err != nil {
		badRequest(w, fmt.Errorf("invalid form body: %w", err))
		return
	}
