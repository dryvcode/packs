{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == link.id -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro go_type(value) -%}
{%- if value is none -%}any
{%- elif value.is.schema -%}{{ symbol_for(value.schema) or 'any' }}
{%- elif value.is.enum -%}{{ symbol_for(value.property.enum) or 'any' }}
{%- elif value.is.boolean -%}bool
{%- elif value.is.integer -%}int64
{%- elif value.is.number -%}float64
{%- elif value.is.string or value.is.temporal -%}string
{%- elif value.is.record -%}map[string]any
{%- else -%}any
{%- endif -%}
{%- endmacro -%}

{%- macro optional_binding(operation, binding) -%}
{%- if binding.port.field is not none -%}
{%- for field in operation.input.fields -%}
{%- if field.name.raw == binding.port.field.raw and field.optional -%}x{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endmacro -%}

{%- macro binding_var(binding) -%}
{%- if binding.is.path -%}path{{ binding.port.name.pascal }}
{%- elif binding.is.query -%}query{{ binding.port.name.pascal }}
{%- elif binding.is.query_object -%}queryObject{{ binding.port.name.pascal }}
{%- elif binding.is.header -%}header{{ binding.port.name.pascal }}
{%- elif binding.is.cookie -%}cookie{{ binding.port.name.pascal }}
{%- elif binding.is.body -%}{% if binding.port.field is none %}input{% else %}body{{ binding.port.name.pascal }}{% endif %}
{%- elif binding.is.form -%}form{{ binding.port.name.pascal }}
{%- else -%}unsupported{{ binding.port.name.pascal }}
{%- endif -%}
{%- endmacro -%}

{%- macro enum_check(value, var) -%}
{%- if value.is.enum %}
	switch {{ var }} {
{%- for item in value.property.enum.values %}
	case {{ symbol_for(value.property.enum) }}{{ item.name.pascal }}:
{%- endfor %}
	default:
		badRequest(w, fmt.Errorf("invalid {{ value.property.enum.name.local }} value"))
		return
	}
{%- endif -%}
{%- endmacro -%}

{%- macro parse_into(value, var, raw) -%}
	if err := parseScalar({{ raw }}, &{{ var }}); err != nil {
		badRequest(w, fmt.Errorf("invalid {{ var }}: %w", err))
		return
	}
{{ enum_check(value, var) }}
{%- endmacro -%}

