	if ok{{ field.name.pascal }} {
		parsed := make([]{{ go_type(field.value) }}, 0, len(values{{ field.name.pascal }}))
		for _, raw := range values{{ field.name.pascal }} {
			var item {{ go_type(field.value) }}
