{%- for field in binding.port.value.schema.fields %}
{%- set values = 'r.URL.Query()' if source == 'query' else 'r.PostForm' %}
{%- if field.array is not none %}
	values{{ field.name.pascal }}, ok{{ field.name.pascal }} := {{ values }}["{{ field.name.raw }}"]
{%- if not field.optional %}
	if !ok{{ field.name.pascal }} {
		badRequest(w, fmt.Errorf("missing required {{ source }} field %q", "{{ field.name.raw }}"))
		return
	}
