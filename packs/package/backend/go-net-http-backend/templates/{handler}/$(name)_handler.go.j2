	if !ok{{ field.name.pascal }} || len(values{{ field.name.pascal }}) == 0 {
		badRequest(w, fmt.Errorf("missing required {{ source }} field %q", "{{ field.name.raw }}"))
		return
	}
	var parsed{{ field.name.pascal }} {{ go_type(field.value) }}
{{ parse_into(field.value, 'parsed' ~ field.name.pascal, 'values' ~ field.name.pascal ~ '[0]') }}
{%- if field.nullable %}
	{{ object }}.{{ field.name.pascal }} = &parsed{{ field.name.pascal }}
{%- else %}
	{{ object }}.{{ field.name.pascal }} = parsed{{ field.name.pascal }}
{%- endif %}
{%- endif %}
{%- endif %}
{%- endfor -%}
{%- endmacro -%}

{%- macro whole_binding(http, kind) -%}
{%- for binding in http.inputs -%}
{%- if binding.port.field is none and ((kind == 'body' and binding.is.body) or (kind == 'query_object' and binding.is.query_object) or (kind == 'form' and binding.is.form)) -%}x{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro field_source(operation, http, field) -%}
{%- if whole_binding(http, 'query_object') -%}queryObjectInput.{{ field.name.pascal }}
{%- elif whole_binding(http, 'form') -%}formInput.{{ field.name.pascal }}
{%- else -%}
{%- set state = namespace(found=false) -%}
{%- for binding in http.inputs -%}
{%- if binding.port.field is not none and binding.port.field.raw == field.name.raw -%}
{%- set state.found = true -%}{{ binding_var(binding) }}
{%- endif -%}
{%- endfor -%}
{%- if not state.found -%}nil{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{%- macro success_status(http) -%}
{%- set result = namespace(code=200) -%}
{%- for binding in http.outputs -%}{%- set result.code = binding.status -%}{%- endfor -%}
