{%- elif value.is.enum and symbol_for(value.property.enum) -%}{{ symbol_for(value.property.enum) }}::from({{ expression }})
{%- else -%}{{ expression }}
{%- endif -%}
{%- endmacro -%}

{%- macro encode_value(value, expression) -%}
{%- if value.is.schema and symbol_for(value.schema) -%}{{ expression }}->toArray()
{%- elif value.is.enum and symbol_for(value.property.enum) -%}{{ expression }}->jsonSerialize()
{%- else -%}{{ expression }}
{%- endif -%}
{%- endmacro -%}

