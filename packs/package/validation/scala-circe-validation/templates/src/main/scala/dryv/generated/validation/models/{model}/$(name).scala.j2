package {{ pack.inputs.root_package }}.models

import java.util.UUID

import io.circe.{Decoder, DecodingFailure, Encoder, Json, JsonObject}
import io.circe.syntax.*

{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == link.id and dependency.symbol -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro scala_ident(name) -%}
{%- if name in ['abstract','case','catch','class','def','do','else','enum','export','extends','false','final','finally','for','forSome','given','if','implicit','import','lazy','match','new','null','object','opaque','open','override','package','private','protected','return','sealed','super','then','this','throw','trait','transparent','true','try','type','using','val','var','while','with','yield','end','extension','inline','infix','derives'] -%}{{ name }}_{%- else -%}{{ name }}{%- endif -%}
{%- endmacro -%}

{%- macro base_type(value) -%}
{%- if value is none or value.is.unknown or value.is.dynamic or value.is.generic or value.is.composite or value.is.union or value.is.tuple or value.is.literal -%}Json
{%- elif value.is.schema -%}{{ symbol_for(value.schema) or 'Json' }}
{%- elif value.is.enum -%}{{ symbol_for(value.property.enum) or 'Json' }}
{%- elif value.is.boolean -%}Boolean
{%- elif value.is.integer -%}Long
{%- elif value.is.decimal or value.is.money -%}BigDecimal
{%- elif value.is.number -%}Double
{%- elif value.is.uuid -%}UUID
{%- elif value.is.record -%}Map[String, Json]
{%- elif value.is.string or value.is.temporal -%}String
{%- else -%}Json
{%- endif -%}
{%- endmacro -%}

{%- macro raw_field_type(field) -%}
{%- if field.array is not none -%}List[{{ base_type(field.value) }}]{%- else -%}{{ base_type(field.value) }}{%- endif -%}
{%- endmacro -%}

{%- macro field_type(field) -%}
{%- if field.optional or field.nullable -%}Option[{{ raw_field_type(field) }}]{%- else -%}{{ raw_field_type(field) }}{%- endif -%}
{%- endmacro -%}

final case class {{ file.symbol }}(
{%- for field in schema.fields %}
  {{ scala_ident(field.name.camel) }}: {{ field_type(field) }}{% if not loop.last %},{% endif %}
{%- endfor %}
)

object {{ file.symbol }}:
  given Encoder.AsObject[{{ file.symbol }}] =
    Encoder.AsObject.instance(value =>
      JsonObject.fromIterable(
        List(
{%- for field in schema.fields %}
{%- if field.optional %}
          value.{{ scala_ident(field.name.camel) }}.map(item => {{ field.name.raw | tojson }} -> item.asJson){% if not loop.last %},{% endif %}
{%- else %}
          Some({{ field.name.raw | tojson }} -> value.{{ scala_ident(field.name.camel) }}.asJson){% if not loop.last %},{% endif %}
{%- endif %}
{%- endfor %}
        ).flatten
      )
    )

  given Decoder[{{ file.symbol }}] =
    Decoder.instance(cursor =>
      for
{%- for field in schema.fields %}
{%- if field.nullable and not field.optional %}
        {{ scala_ident(field.name.camel) }} <-
          if cursor.downField({{ field.name.raw | tojson }}).succeeded then
            cursor.downField({{ field.name.raw | tojson }}).as[{{ field_type(field) }}]
          else
            Left(DecodingFailure("Missing required field {{ field.name.raw }}", cursor.history))
{%- else %}
        {{ scala_ident(field.name.camel) }} <- cursor.downField({{ field.name.raw | tojson }}).as[{{ field_type(field) }}]
{%- endif %}
{%- endfor %}
      yield {{ file.symbol }}(
{%- for field in schema.fields %}
        {{ scala_ident(field.name.camel) }}{% if not loop.last %},{% endif %}
{%- endfor %}
      )
    )
