{%- elif field.value.is.enum %}
        RuleForEach(value => value.{{ cs_ident(field.name.pascal) }})
            .Must(item => item.IsValid)
            .When(value => value.{{ cs_ident(field.name.pascal) }} is not null);
{%- elif field.value.is.primitive and field.value.property.primitive.is.string %}
{{ string_rules(field, 'RuleForEach(value => value.' ~ cs_ident(field.name.pascal) ~ ')') }}
{%- elif field.value.is.primitive and field.value.property.primitive.is.number %}
{{ numeric_rules(field, 'RuleForEach(value => value.' ~ cs_ident(field.name.pascal) ~ ')') }}
{%- endif %}
{%- else %}
{%- if field.value.is.schema and validator_for(field.value.schema) %}
        {{ property }}.SetValidator(new {{ validator_for(field.value.schema) }}()!)
            .When(value => value.{{ cs_ident(field.name.pascal) }} is not null);
