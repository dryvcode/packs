            .WithMessage("{{ field.name.raw }} must be a valid URL");
{%- endif %}
{%- if primitive.is.uuid %}
        {{ expr }}.Matches("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$");
{%- elif primitive.is.ulid %}
        {{ expr }}.Matches("^[0-9A-HJKMNP-TV-Z]{26}$");
{%- elif primitive.is.e164 %}
        {{ expr }}.Matches("^\\+[1-9][0-9]{1,14}$");
{%- elif primitive.is.phone %}
        {{ expr }}.Matches("^\\+?[0-9 ().-]{7,20}$");
{%- elif primitive.is.slug %}
        {{ expr }}.Matches("^[a-z0-9]+(?:-[a-z0-9]+)*$");
{%- elif primitive.is.hex_color %}
        {{ expr }}.Matches("^#?(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$");
{%- elif primitive.is.hex %}
        {{ expr }}.Matches("^[0-9a-fA-F]+$");
{%- endif %}
{%- if primitive.constraints.pattern is not none %}
{%- for expression in primitive.constraints.pattern.match_json %}
        {{ expr }}.Matches({{ expression }});
{%- endfor %}
{%- endif -%}
{%- endmacro -%}
{%- macro numeric_rules(field, expr) -%}
{%- set range = field.value.property.primitive.constraints.range -%}
{%- if range is not none and range.has_min %}
        {{ expr }}.GreaterThanOrEqualTo({{ range.min }});
{%- endif %}
{%- if range is not none and range.has_max %}
        {{ expr }}.LessThanOrEqualTo({{ range.max }});
{%- endif -%}
{%- endmacro -%}
{%- macro operand(value) -%}
{%- if value.is.field -%}value.{{ cs_ident(value.field.pascal) }}
{%- elif value.is.literal -%}{{ value.value_json }}
{%- else -%}null
{%- endif -%}
{%- endmacro -%}
{%- macro invariant_supported(invariant) -%}
{%- if not invariant.form.is.opaque -%}
{%- set state = namespace(ok=true) -%}
{%- for comparison in invariant.form.comparisons -%}
{%- if comparison.left.is.arithmetic or comparison.right.is.arithmetic -%}{%- set state.ok=false -%}{%- endif -%}
{%- endfor -%}
{%- if state.ok -%}x{%- endif -%}
{%- endif -%}
{%- endmacro -%}
{%- macro predicate(invariant) -%}
{%- for comparison in invariant.form.comparisons -%}
Compare({{ operand(comparison.left) }}, {{ operand(comparison.right) }}, "{{ comparison.operator }}"){% if not loop.last %}{% if invariant.form.is.all %} && {% else %} || {% endif %}{% endif %}
{%- endfor -%}
{%- endmacro -%}
