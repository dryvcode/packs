        {{ property }}.Must(value => value is null || value.Count <= {{ field.array.max }})
            .WithMessage("{{ field.name.raw }} must contain at most {{ field.array.max }} item(s)");
{%- endif %}
{%- if field.value.is.schema and validator_for(field.value.schema) %}
        RuleForEach(value => value.{{ cs_ident(field.name.pascal) }})
            .SetValidator(new {{ validator_for(field.value.schema) }}())
