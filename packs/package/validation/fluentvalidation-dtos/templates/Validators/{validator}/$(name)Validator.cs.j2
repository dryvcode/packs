    }

    private static bool Compare(object? left, object? right, string operation)
    {
        if (operation == "equal") return Equals(left, right);
        if (operation == "not-equal") return !Equals(left, right);
        if (left is null || right is null) return true;

        int comparison;
        if (left is IConvertible && right is IConvertible)
        {
            try
            {
                comparison = Convert.ToDecimal(left, CultureInfo.InvariantCulture)
                    .CompareTo(Convert.ToDecimal(right, CultureInfo.InvariantCulture));
            }
            catch
            {
                if (left is not IComparable comparable || left.GetType() != right.GetType()) return false;
                comparison = comparable.CompareTo(right);
            }
        }
        else if (left is IComparable comparable && left.GetType() == right.GetType())
        {
            comparison = comparable.CompareTo(right);
        }
        else
        {
            return false;
        }

        return operation switch
        {
            "less-than" => comparison < 0,
            "less-than-or-equal" => comparison <= 0,
            "greater-than" => comparison > 0,
            "greater-than-or-equal" => comparison >= 0,
            _ => false,
        };
    }
