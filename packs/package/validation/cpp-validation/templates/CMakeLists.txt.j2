cmake_minimum_required(VERSION 3.23)
project(dryv_cpp_validation VERSION 0.1.0 LANGUAGES CXX)

find_package(nlohmann_json 3.12.0 CONFIG REQUIRED)

add_library(dryv_cpp_validation INTERFACE)
target_compile_features(dryv_cpp_validation INTERFACE cxx_std_20)
target_include_directories(dryv_cpp_validation INTERFACE ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_link_libraries(dryv_cpp_validation INTERFACE nlohmann_json::nlohmann_json)
