{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == link.id -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro go_type(value) -%}
{%- if value is none -%}any
{%- elif value.is.schema -%}{{ symbol_for(value.schema) or 'any' }}
{%- elif value.is.enum -%}{{ symbol_for(value.property.enum) or 'any' }}
{%- elif value.is.boolean -%}bool
{%- elif value.is.integer -%}int64
{%- elif value.is.number -%}float64
{%- elif value.is.string or value.is.temporal -%}string
{%- elif value.is.record -%}map[string]any
{%- else -%}any
{%- endif -%}
{%- endmacro -%}

{%- macro field_type(field) -%}
{%- if field.optional or field.nullable %}*{% endif -%}
{%- if field.array is not none %}[]{% endif -%}
{{- go_type(field.value) -}}
{%- endmacro -%}

{%- macro element_tags(field) -%}
{%- set value = field.value -%}
{%- if value.is.primitive -%}
{%- set primitive = value.property.primitive -%}
{%- if primitive.is.string -%}
{%- set length = primitive.constraints.length -%}
{%- if length is not none and length.has_exact -%},len={{ length.exact }}
{%- else -%}
{%- if length is not none and length.has_min -%},min={{ length.min }}{%- endif -%}
{%- if length is not none and length.has_max -%},max={{ length.max }}{%- endif -%}
{%- endif -%}
{%- if primitive.is.email -%},email
{%- elif primitive.is.url or primitive.is.uri -%},url
{%- endif -%}
{%- elif primitive.is.number -%}
{%- set range = primitive.constraints.range -%}
{%- if range is not none and range.has_min -%},gte={{ range.min }}{%- endif -%}
{%- if range is not none and range.has_max -%},lte={{ range.max }}{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{%- macro validation_tag(field) -%}
{%- set ns = namespace(parts=[]) -%}
{%- if field.optional or field.nullable -%}
{%- set ns.parts = ns.parts + ['omitempty'] -%}
{%- endif -%}
{%- if field.array is not none -%}
{%- if field.array.has_min -%}{%- set ns.parts = ns.parts + ['min=' ~ field.array.min] -%}{%- endif -%}
{%- if field.array.has_max -%}{%- set ns.parts = ns.parts + ['max=' ~ field.array.max] -%}{%- endif -%}
{%- set ns.parts = ns.parts + ['dive'] -%}
{%- set element = element_tags(field) | trim -%}
{%- if element -%}
{%- for item in element.lstrip(',').split(',') -%}
{%- if item -%}{%- set ns.parts = ns.parts + [item] -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- else -%}
{%- set element = element_tags(field) | trim -%}
{%- if element -%}
{%- for item in element.lstrip(',').split(',') -%}
{%- if item -%}{%- set ns.parts = ns.parts + [item] -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endif -%}
{{- ns.parts | join(',') -}}
{%- endmacro -%}

{%- macro format_regex(field) -%}
{%- if field.value.is.uuid -%}^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$
{%- elif field.value.is.ulid -%}^[0-9A-HJKMNP-TV-Z]{26}$
{%- elif field.value.is.e164 -%}^\+[1-9][0-9]{1,14}$
{%- elif field.value.is.phone -%}^\+?[0-9 ().-]{7,20}$
{%- elif field.value.is.slug -%}^[a-z0-9]+(?:-[a-z0-9]+)*$
{%- elif field.value.is.hex_color -%}^#?(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$
{%- elif field.value.is.hex -%}^[0-9a-fA-F]+$
{%- elif field.value.is.jwt -%}^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]*$
{%- elif field.value.is.semver -%}^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$
{%- elif field.value.is.country_code -%}^[A-Z]{2}$
{%- elif field.value.is.currency_code -%}^[A-Z]{3}$
{%- endif -%}
{%- endmacro -%}

{%- macro has_format_regex(field) -%}
{%- if field.value.is.uuid or field.value.is.ulid or field.value.is.e164 or field.value.is.phone or field.value.is.slug or field.value.is.hex_color or field.value.is.hex or field.value.is.jwt or field.value.is.semver or field.value.is.country_code or field.value.is.currency_code -%}x{%- endif -%}
{%- endmacro -%}

